# Copy to .env (gitignored) and fill in. Read by experiments/ibm_dryrun/collect.py --submit.
# Create the API key at https://quantum.cloud.ibm.com (Account > API key).
QISKIT_IBM_TOKEN=
# Instance CRN (or name) of a Flex / Premium / On-Prem plan; dry-run jobs need one of those plans.
QISKIT_IBM_INSTANCE=
# Optional: a backend (e.g. ibm_phoenix) or its mock (mock_phoenix). Empty = least busy.
QISKIT_IBM_BACKEND=
